      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lets no app write in another one. Only a keyboard can: that is why Pressay comes with one. The globe key always brings back Apple’s keyboard."
          }
