    "setup.microphone.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your voice is transcribed on the iPhone, by Pressay’s engine or Apple’s. No audio is sent over the internet, and none is kept once transcribed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre voix est transcrite sur l’iPhone, par le moteur de Pressay ou celui d’Apple. Aucun son n’est envoyé sur Internet, et aucun n’est gardé après la transcription."
          }
        }
      }
    },
