    "setup.keyboard.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Pressay keyboard writes the dictated text in the field you are in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le clavier Pressay qui écrit le texte dicté dans le champ où vous êtes."
