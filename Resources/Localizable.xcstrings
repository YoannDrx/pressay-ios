            "value" : "Everything happens on the iPhone: the app transcribes, the keyboard inserts. If nothing is written, check that the Pressay keyboard is the one showing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout se passe sur l’iPhone : l’app transcrit, le clavier insère. Si rien ne s’écrit, vérifiez que c’est bien le clavier Pressay qui est affiché."
          }
        }
      }
    },
    "setup.fullAccess.field" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap here, then show the Pressay keyboard"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez ici, puis affichez le clavier Pressay"
          }
        }
      }
    },
    "setup.fullAccess.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Settings, under Keyboards (or General > Keyboard > Keyboards > Pressay), turn on Allow Full Access, then tap Allow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les Réglages, sous « Claviers » (ou Général > Clavier > Claviers > Pressay), activez « Autoriser l’accès complet », puis touchez « Autoriser »."
          }
        }
      }
    },
    "setup.fullAccess.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come back here and tap the field above."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez ici et touchez le champ ci-dessus."
          }
        }
      }
    },
    "setup.fullAccess.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to the Pressay keyboard with the globe key: the step ticks itself as soon as it shows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez au clavier Pressay avec la touche globe : l’étape se coche dès qu’il s’affiche."
          }
        }
      }
    },
    "setup.fullAccess.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without it, the keyboard cannot receive the text from the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans lui, le clavier ne peut pas recevoir le texte de l’app."
          }
        }
      }
    },
    "setup.fullAccess.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Full Access"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer l’accès complet"
          }
        }
      }
    },
    "setup.fullAccess.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS shows the same warning for every third-party keyboard. Pressay uses Full Access only to receive the dictated text from the app, on the iPhone. The keyboard never goes online and does not record what you type."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS affiche le même avertissement pour tous les claviers tiers. Pressay s’en sert uniquement pour recevoir le texte dicté depuis l’app, sur l’iPhone. Le clavier n’utilise jamais Internet et n’enregistre pas ce que vous tapez."
          }
        }
      }
    },
