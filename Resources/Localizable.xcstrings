    "sync.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dictionary, modes and active mode stay the same on your Mac and your iPhone. They are encrypted on your devices, so the server cannot read them. Audio, history and dictated text are never synced."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dictionnaire, vos modes et votre mode actif restent les mêmes sur votre Mac et votre iPhone. Ils sont chiffrés sur vos appareils : le serveur ne peut pas les lire. La voix, l’historique et les textes dictés ne sont jamais synchronisés."
          }
        }
