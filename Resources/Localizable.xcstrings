    "setup.keyboard.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lets no app write in another one. Only a keyboard can: that is why Pressay comes with one. The globe key always brings back Apple’s keyboard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne laisse aucune app écrire dans une autre. Seul un clavier le peut : c’est pour ça que Pressay en fournit un. La touche globe ramène toujours le clavier d’Apple."
          }
        }
      }
    },
