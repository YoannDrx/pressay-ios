    "account.awaitingDevice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are signed in, but this iPhone is not connected to your account yet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes connecté, mais cet iPhone n’est pas encore relié à votre compte."
          }
        }
      }
    },
    "account.delete" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete account"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer le compte"
          }
        }
      }
    },
    "account.delete.apple.anyway" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete my account anyway"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer quand même mon compte"
          }
        }
      }
    },
    "account.delete.apple.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account does not cancel it: Apple keeps billing until you cancel it in your Apple Account. You can cancel it first, or delete your account anyway."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer votre compte ne le résilie pas : Apple continue de facturer tant que vous ne le résiliez pas depuis votre compte Apple. Vous pouvez d’abord le résilier, ou supprimer quand même votre compte."
          }
        }
      }
    },
    "account.delete.apple.manage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage my subscription"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérer mon abonnement"
          }
        }
      }
    },
    "account.delete.apple.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your App Store subscription is still active"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre abonnement App Store est toujours actif"
          }
        }
      }
    },
    "account.delete.confirm.action" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete my account"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer mon compte"
          }
        }
      }
    },
    "account.delete.confirm.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be undone. Your account, its devices and your encrypted sync data will be deleted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est définitif. Votre compte, ses appareils et vos données de synchro chiffrées seront supprimés."
          }
        }
      }
    },
    "account.delete.confirm.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete your Pressay account?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer votre compte Pressay ?"
          }
        }
      }
    },
    "account.delete.done" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account deletion has been requested. This iPhone is signed out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de votre compte est demandée. Cet iPhone est déconnecté."
          }
        }
      }
    },
    "account.delete.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes your account, its devices and your encrypted sync data. Your dictations stay on this iPhone, and the app keeps working without an account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime votre compte, ses appareils et vos données de synchro chiffrées. Vos dictées restent sur cet iPhone et l’app continue de fonctionner sans compte."
          }
        }
      }
    },
    "account.deviceLimit.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro works on three devices. Remove one to use it on this iPhone. Everything free keeps working in the meantime."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro fonctionne sur trois appareils. Retirez-en un pour l’utiliser sur cet iPhone. Tout ce qui est gratuit continue de fonctionner en attendant."
          }
        }
      }
    },
    "account.deviceLimit.title" : {
      "extractionState" : "manual",
      "localizations" : {
